    "# 2. Creazione fasce FICO anche sul Test Set\n",
    "test['fico_range'] = pd.cut(test['fico_score'], bins=bins, labels=labels)\n",
    "\n",
    "# 3. Applicazione della Strategia Finale (Soglia differenziata)\n",
    "def final_strategy(row):\n",
