    "        # Se c'è stata delinquency reale (> 0), perdiamo il capitale\n",
    "        else:\n",
    "            return DEFAULT_LOSS\n",
    "\n",
    "# Applichiamo il calcolo al dataframe test\n",
    "test['net_profit'] = test.apply(calculate_money_final, axis=1)\n",
