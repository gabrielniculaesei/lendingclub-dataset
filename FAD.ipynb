      "VALIDATION SET\n",
      "Accuracy : 0.6377730796335448\n",
      "Precision: 0.23774954627949182\n",
      "Recall   : 0.5822222222222222\n",
      "F1-score : 0.33762886597938147\n",
      "ROC-AUC  : 0.6711967243625535\n",
