      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "TABELLA DI CONTINGENZA: Purpose vs Not Fully Paid\n",
            "not_fully_paid         0    1\n",
            "purpose                      \n",
            "all_other           1909  379\n",
            "credit_card         1113  145\n",
            "debt_consolidation  3344  598\n",
